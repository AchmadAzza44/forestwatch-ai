# Salin menjadi backend/.env dan GANTI semua nilai sebelum dipakai di luar laptop pengembangan.
DATABASE_URL=postgresql://forestwatch:GANTI_PASSWORD@localhost:5432/forestwatch
SECRET_KEY=GANTI_DENGAN_STRING_ACAK_PANJANG
ENVIRONMENT=development
CONFIDENCE_THRESHOLD=0.45
OPERATOR_TOKEN=GANTI_TOKEN_OPERATOR_ACAK
ADMIN_TOKEN=GANTI_TOKEN_ADMIN_ACAK
